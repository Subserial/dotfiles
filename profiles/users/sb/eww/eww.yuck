;; profiles/users/sb/eww/eww.yuck
;; Eww configuration for user sb

;; -------------------
;; POLLERS & LISTENERS
;; -------------------
(defpoll time :interval "1s" "date '+%H:%M'")
(defpoll date :interval "30s" "date '+%A, %d %B %Y'")
(defpoll display_mode :interval "2s" "scripts/display-select.sh status")
(defpoll volume_val :interval "1s" "scripts/volume.sh get")
(defpoll volume_icon :interval "1s" "scripts/volume.sh icon")
(defpoll brightness_val :interval "2s" "scripts/brightness.sh get")
(deflisten workspace_data :initial "{\"ws\":\"1 | 1\",\"submap\":false}" "scripts/workspaces.sh")
(defpoll active_window :interval "1s" "hyprctl activewindow -j 2>/dev/null | jq -r '.title // \"\"' | cut -c 1-45")
(defvar shutdown_confirm false)

;; -------------------
;; BAR WIDGET LAYOUT
;; -------------------
(defwidget bar_layout []
  (centerbox :class "bar-container" :orientation "h"
    ;; Left: Workspaces (<top> | <bottom>) & active window title
    (box :class "left-modules" :space-evenly false :halign "start"
      (button :class "workspace-badge ${workspace_data.submap ? 'selector-active' : ''}"
              :onclick "scripts/workspace-selector.sh"
              :tooltip "Workspaces (Top | Bottom). Click to enter selector mode (press 0-9)"
              "${workspace_data.ws}")
      (box :class "module-box" :visible {active_window != ""}
        (label :class "window-title" :text active_window :limit-width 45)))

    ;; Center: Clock and Date
    (box :class "center-modules" :space-evenly false :halign "center"
      (box :class "module-box" :space-evenly false
        (label :class "clock-text" :text time)
        (label :class "date-text" :text "•  ${date}")))

    ;; Right: Volume and control panel button
    (box :class "right-modules" :space-evenly false :halign "end"
      (eventbox :onscroll "if [ '{}' = 'up' ]; then wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; else wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-; fi"
        (button :class "module-box volume-box" :onclick "scripts/volume.sh toggle-mute" :tooltip "Click to mute, scroll to change volume"
          (box :space-evenly false :spacing 6
            (label :class "vol-icon" :text volume_icon)
            (label :class "vol-text" :text "${volume_val}%"))))
      (button :class "panel-toggle-btn" :onclick "scripts/toggle-control-center.sh" " Controls"))))

;; -------------------
;; TASKBAR WINDOWS
;; -------------------
(defwindow bar_dp
  :monitor "DP-1"
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "36px" :anchor "bottom center")
  :stacking "fg"
  :exclusive true
  (bar_layout))

(defwindow bar_hdmi
  :monitor "HDMI-A-1"
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "36px" :anchor "bottom center")
  :stacking "fg"
  :exclusive true
  (bar_layout))

(defwindow bar
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "36px" :anchor "bottom center")
  :stacking "fg"
  :exclusive true
  (bar_layout))

;; ---------------------------
;; CONTROL CENTER BACKDROPS
;; ---------------------------
(defwindow control_center_catcher_dp
  :monitor "DP-1"
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "100%" :anchor "top left")
  :stacking "overlay"
  :exclusive false
  (eventbox :class "catcher-box" :onclick "scripts/toggle-control-center.sh close"))

(defwindow control_center_catcher_hdmi
  :monitor "HDMI-A-1"
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "100%" :anchor "top left")
  :stacking "overlay"
  :exclusive false
  (eventbox :class "catcher-box" :onclick "scripts/toggle-control-center.sh close"))

(defwindow control_center_catcher
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "100%" :anchor "top left")
  :stacking "overlay"
  :exclusive false
  (eventbox :class "catcher-box" :onclick "scripts/toggle-control-center.sh close"))

;; ---------------------------
;; CONTROL CENTER OVERLAY
;; ---------------------------
(defwindow control_center
  :monitor 0
  :geometry (geometry :x "12px" :y "48px" :width "400px" :anchor "bottom right")
  :stacking "overlay"
  :exclusive false
  (box :class "control-center-box" :orientation "v" :space-evenly false
    ;; Header
    (box :class "header-box" :space-evenly false
      (box :orientation "v" :space-evenly false :hexpand true
        (label :class "header-time" :text time :halign "start")
        (label :class "header-date" :text date :halign "start")))

    ;; Display Mode Selector
    (box :orientation "v" :space-evenly false
      (label :class "section-title" :text "Display Layout (External Only)" :halign "start")
      (box :class "display-selector-box" :space-evenly true
        (button :class "disp-btn ${display_mode == 'extend' ? 'active' : ''}"
                :onclick "scripts/display-select.sh extend" "󰍹 Extend (Dual)")
        (button :class "disp-btn ${display_mode == 'mirror' ? 'active' : ''}"
                :onclick "scripts/display-select.sh mirror" "󰍺 Mirror (Clone)")))

    ;; Program Shortcuts
    (box :orientation "v" :space-evenly false
      (label :class "section-title" :text "Applications" :halign "start")
      (box :class "shortcuts-box" :orientation "v" :spacing 6
        (box :space-evenly true :spacing 6
          (button :class "app-btn" :onclick "scripts/launch-or-focus.sh alacritty" " Terminal")
          (button :class "app-btn" :onclick "scripts/launch-or-focus.sh firefox" " Browser")
          (button :class "app-btn" :onclick "scripts/launch-or-focus.sh files" " Files"))
        (box :space-evenly true :spacing 6
          (button :class "app-btn" :onclick "scripts/launch-or-focus.sh kcalc" " Calculator")
          (button :class "app-btn" :onclick "scripts/launch-or-focus.sh discord" " Discord")
          (button :class "app-btn" :onclick "scripts/launch-or-focus.sh steam" " Steam"))))

    ;; Audio Volume
    (box :orientation "v" :space-evenly false
      (label :class "section-title" :text "Audio Volume" :halign "start")
      (box :class "sliders-box" :orientation "v"
        (box :class "slider-item" :space-evenly false
          (button :class "slider-icon" :onclick "scripts/volume.sh toggle-mute" volume_icon)
          (scale :min 0 :max 101 :value volume_val :hexpand true
                 :onchange "scripts/volume.sh set {}"))))

    ;; Screen Brightness
    (box :orientation "v" :space-evenly false
      (label :class "section-title" :text "Brightness" :halign "start")
      (box :class "sliders-box" :orientation "v"
        (box :class "slider-item" :space-evenly false
          (label :class "slider-icon" :text "󰃠")
          (scale :min 10 :max 101 :value brightness_val :hexpand true
                 :onchange "scripts/brightness.sh set {}"))))

    ;; Session Controls
    (box :class "session-box" :space-evenly true
      (button :class "session-btn" :onclick "loginctl lock-session & eww close control_center" " Lock")
      (button :class "session-btn" :onclick "systemctl suspend & eww close control_center" " Suspend")
      (button :class "session-btn" :onclick "hyprctl reload & eww reload" " Reload")
      (button :class "session-btn ${shutdown_confirm ? 'confirm-accent' : 'danger'}"
              :onclick "scripts/shutdown-action.sh"
              "${shutdown_confirm ? ' Shutdown?' : ' Shutdown'}"))))
